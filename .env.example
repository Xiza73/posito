# Supabase (usado solo como Postgres). Supabase → Connect → ORMs / Connection string.
# App: Transaction pooler (puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Migraciones (drizzle-kit): Session pooler (puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="genera-uno-con: bun -e \"console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))\""
BETTER_AUTH_URL="http://localhost:3000"

# Supabase Storage (fotos de producto), vía REST. SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
# SUPABASE_URL: botón Connect → Project URL. SOLO la base (https://<ref>.supabase.co), sin /rest/v1.
# SUPABASE_SERVICE_ROLE_KEY: Settings → API Keys → clave "secret" (sb_secret_…; la legacy service_role eyJ… también sirve
#   pero Supabase la retira a fines de 2026). SECRETA: salta RLS; no commitear ni loguear.
# Storage NO necesita la Data API: déjala APAGADA (sin RLS en nuestras tablas, la expondría).
# Después de definirlas: bun run storage:setup (crea el bucket "product-images").
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

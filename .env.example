# Supabase (usado solo como Postgres). Usa la connection string del pooler (Transaction mode).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Better Auth
BETTER_AUTH_SECRET="genera-uno-con: bunx @better-auth/cli secret"
BETTER_AUTH_URL="http://localhost:3000"
